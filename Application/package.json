{
  "name": "proxy-bridge",
  "version": "0.1.0",
  "description": "全局代理桌面应用：让整台 Windows 的流量经由远程代理服务器",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.main.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"tests-dist/tests/*.test.js\"",
    "icon": "electron scripts/make-icons.mjs",
    "dist": "npm run build && npm run icon && node scripts/build-dist.mjs",
    "dist:dir": "npm run build && npm run icon && node scripts/build-dist.mjs --dir",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','tests-dist','release'])fs.rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
